# Copy this file to .env and fill in what you need. Everything has a
# sensible default -- an empty .env still runs.

# ---- Site ----
TITLE=My Stream
DESCRIPTION=
AUTHOR_NAME=
AUTHOR_EMAIL=
AUTHOR_WEBSITE=
# Public URL of your site, no trailing slash. Used for RSS links, Open
# Graph tags, and Share links -- set this once you have a real domain.
URL=http://localhost:4000

# ---- Server ----
PORT=4000
HOST=0.0.0.0
# Where to scan for photos/videos, and where derivatives are cached.
# Inside Docker these are already set correctly in the Dockerfile --
# only change them for a bare-metal / non-Docker run.
# MEDIA_DIR=media/original
# CACHE_DIR=.cache

# ---- Behavior ----
SHOW_RSS_FEED=1
DEFAULT_REVERSE_SORT=0
ALLOW_ORDER_SORT_CHANGE=1
ALLOW_ORIGINAL_DOWNLOAD=1
ALLOW_INDEXING=1
ALLOW_IMAGE_SHARING=1

# Auto-detect new files dropped into the media folder (no restart
# needed). Falls back gracefully to manual rescan if your filesystem
# doesn't support recursive watching (some network mounts).
WATCH_FOR_CHANGES=1
# Belt-and-suspenders periodic rescan, in minutes. 0 disables it.
RESCAN_INTERVAL_MINUTES=0
# How many photos/videos to process at once during a scan. Video
# transcoding and detection are CPU-heavy -- lower this on small/shared
# hosts.
PROCESSING_CONCURRENCY=2

# ---- Video previews ----
# Muted, looping preview clips that autoplay as tiles scroll into view
# and on hover. Turn off on bandwidth-constrained hosts -- previews
# then only play on hover (desktop) or when opened.
VIDEO_AUTOPLAY_PREVIEWS=1
VIDEO_PREVIEW_DURATION=5
# New: encode preview at up to 60fps (never more than original media FPS).
VIDEO_PREVIEW_FPS=60
VIDEO_PREVIEW_MAX_WIDTH=480

# ---- Derivative sizes (pixels, longest edge, comma-separated) ----
# Each size is generated and served via responsive srcset, so phones
# and retina displays automatically get an appropriately-sized image
# instead of one fixed resolution for everyone. A single value (e.g.
# THUMBNAIL_MAX=640) still works and is treated as a one-item list.
THUMBNAIL_SIZES=320,640,960
LARGE_SIZES=1280,2048
POSTER_SIZES=480,960

# ---- Detection ----
# Presence detection (faces, cats), OCR text extraction, and
# near-duplicate grouping -- all run locally, no cloud APIs. Scoped to
# whole-person/whole-animal presence and text extraction for library
# organization and search, not fine-grained body-region analysis.
# Each adds real processing time per item, so each is independently
# toggleable if you want to skip it on slower hardware.
ENABLE_FACE_DETECTION=1
ENABLE_PET_DETECTION=1
ENABLE_OCR=1
ENABLE_DUPLICATE_DETECTION=1
# Two photos/videos whose perceptual hash differs by this many bits
# (0-64) or fewer are grouped as likely duplicates. Lower = stricter.
# Note: very low-detail/uniform images (a blank wall, a solid-color
# slide) can occasionally hash close to each other and get grouped
# even when they aren't true duplicates -- an inherent property of
# perceptual hashing, not a bug. Lower this if you notice too many
# false groupings, raise it if near-duplicates aren't being caught.
DUPLICATE_THRESHOLD=10
# General object detection (person/dog/car/chair/... 80 COCO classes),
# AI is OFF by default. For optional downloads, rebuild with
# STREAM_AI_STACK=true. Use the admin dashboard to download a model,
# select CPU/CUDA, enable object detection, and then rescan.
# The optional large stack and selected weights live outside the
# normal fast browsing path. See README for GPU passthrough details.
ENABLE_OBJECT_DETECTION=0
# Build-time Compose options for the optional AI stack:
STREAM_AI_STACK=false
STREAM_AI_ACCELERATOR=cpu

# ---- Optional: Cloudflare Tunnel ----
# Used by `docker compose --profile tunnel up -d`. See "Deploying with Cloudflare"
# in the README (set URL, TRUST_PROXY=1 and REQUIRE_LOGIN=1 too).
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Optional: an SMB share as the library ----
# Used by `docker compose -f docker-compose.yml -f docker-compose.smb.yml up -d --build`.
# Mounted read-only; Stream's own files stay in its own Docker volume.
SMB_HOST=
SMB_SHARE=
SMB_USER=
SMB_PASS=
SMB_VERSION=3.0
# Minutes between rescans (inotify can't see changes other machines make on a share).
SMB_RESCAN_MINUTES=15

# ---- Container memory ----
# 2g covers object detection (PyTorch) plus ffmpeg. With ENABLE_OBJECT_DETECTION=0
# Build-time Compose options for the optional AI stack:
STREAM_AI_STACK=false
STREAM_AI_ACCELERATOR=cpu
# and a build using --build-arg ENABLE_OBJECT_DETECTION=false, 1g is plenty.
STREAM_MEM_LIMIT=2g
