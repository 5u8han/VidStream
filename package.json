{
  "name": "stream",
  "version": "1.9.0-node.2",
  "description": "A self-hosted photo and video stream. Embedded SQLite, no frontend build step and no runtime npm dependencies.",
  "license": "MIT",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "launcher": "node scripts/vidstream-launcher.js --open",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser-regression.cjs",
    "test:nodes": "node test/node-browser-regression.cjs",
    "test:node-lan": "node test/node-lan-smoke.cjs",
    "check": "node scripts/check-syntax.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
